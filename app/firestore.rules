rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if request is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // P0-1: Strict ownership rules
    // READ / DELETE: Document must exist and ownerId must match authenticated user
    function isOwnerReadOrDelete() {
      return isAuthenticated() &&
        resource != null &&
        resource.data != null &&
        resource.data.ownerId == request.auth.uid;
    }

    // CREATE: New document must have ownerId matching authenticated user
    function isOwnerCreate() {
      return isAuthenticated() &&
        request.resource != null &&
        request.resource.data != null &&
        request.resource.data.ownerId == request.auth.uid;
    }

    // UPDATE: Existing document must belong to authenticated user AND ownerId cannot be changed
    function isOwnerUpdate() {
      return isAuthenticated() &&
        resource != null &&
        resource.data != null &&
        resource.data.ownerId == request.auth.uid &&
        request.resource != null &&
        request.resource.data != null &&
        request.resource.data.ownerId == resource.data.ownerId;
    }

    // User Profile Document (keyed by Firebase Auth UID)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Properties Collection
    match /properties/{propertyId} {
      allow read, delete: if isOwnerReadOrDelete();
      allow create: if isOwnerCreate();
      allow update: if isOwnerUpdate();
    }

    // Rooms Collection
    match /rooms/{roomId} {
      allow read, delete: if isOwnerReadOrDelete();
      allow create: if isOwnerCreate();
      allow update: if isOwnerUpdate();
    }

    // Tenants Collection
    match /tenants/{tenantId} {
      allow read, delete: if isOwnerReadOrDelete();
      allow create: if isOwnerCreate();
      allow update: if isOwnerUpdate();
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read, delete: if isOwnerReadOrDelete();
      allow create: if isOwnerCreate();
      allow update: if isOwnerUpdate();
    }

    // Expenses Collection
    match /expenses/{expenseId} {
      allow read, delete: if isOwnerReadOrDelete();
      allow create: if isOwnerCreate();
      allow update: if isOwnerUpdate();
    }

    // Reports Collection
    match /reports/{reportId} {
      allow read, delete: if isOwnerReadOrDelete();
      allow create: if isOwnerCreate();
      allow update: if isOwnerUpdate();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read, delete: if isOwnerReadOrDelete();
      allow create: if isOwnerCreate();
      allow update: if isOwnerUpdate();
    }

    // Tenant Media Collection (Canonical Profile Photos & Documents)
    match /tenant_media/{mediaId} {
      allow read, delete: if isOwnerReadOrDelete();
      allow create: if isOwnerCreate();
      allow update: if isOwnerUpdate();
    }

    // Drive Folder Mappings Collection
    match /drive_folder_mappings/{mappingId} {
      allow read, delete: if isOwnerReadOrDelete();
      allow create: if isOwnerCreate();
      allow update: if isOwnerUpdate();
    }

    // Tenant Registration Forms Collection
    match /tenant_registration_forms/{formId} {
      allow read, delete: if isOwnerReadOrDelete();
      allow create: if isOwnerCreate();
      allow update: if isOwnerUpdate();
    }

    // Pending Tenant Registrations Collection
    match /pending_tenant_registrations/{regId} {
      allow read, delete: if isOwnerReadOrDelete();
      allow create: if isOwnerCreate();
      allow update: if isOwnerUpdate();
    }
  }
}
