rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if request is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Check if the current authenticated user owns the document being created, read, updated, or deleted
    function isOwner() {
      return isAuthenticated() && (
        (request.resource != null && request.resource.data != null && request.resource.data.ownerId == request.auth.uid) ||
        (resource != null && resource.data != null && resource.data.ownerId == request.auth.uid)
      );
    }

    // User Profile Document (keyed by Firebase Auth UID)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Properties Collection
    match /properties/{propertyId} {
      allow read, write: if isOwner();
    }

    // Rooms Collection
    match /rooms/{roomId} {
      allow read, write: if isOwner();
    }

    // Tenants Collection
    match /tenants/{tenantId} {
      allow read, write: if isOwner();
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read, write: if isOwner();
    }

    // Expenses Collection
    match /expenses/{expenseId} {
      allow read, write: if isOwner();
    }

    // Reports Collection
    match /reports/{reportId} {
      allow read, write: if isOwner();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read, write: if isOwner();
    }
  }
}
